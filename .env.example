# Local development defaults use separate SQLite files.
CONTENT_DATABASE_URL=sqlite:///./data/viewtube_content.sqlite
BEHAVIOR_DATABASE_URL=sqlite:///./data/viewtube_behavior.sqlite
DATABASE_URL=sqlite:///./data/viewtube_content.sqlite
NEXT_TELEMETRY_DISABLED=1

# Production example:
# BEHAVIOR_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# VIEWTUBE_STUDY_ONLY=1
# VIEWTUBE_BACKEND_MODE=http
# VIEWTUBE_BACKEND_URL=http://127.0.0.1:8000
# VIEWTUBE_MONITOR_TOKEN=replace-with-a-long-random-token
